# Base Sepolia Network & Keeper RPC
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Keeper Account Private Key (Must hold Base Sepolia ETH for gas)
KEEPER_PRIVATE_KEY=0x_YOUR_KEEPER_PRIVATE_KEY

# Token & Lending Protocol Addresses
MOONWELL_MUSDC=0x7B35C6AddbB9bb30c640A5D8ae4ecD42BFcD2C19
MOONWELL_COMPTROLLER=0xA92c06c03ab912788c71F74eB0C828E84A159C0a
MORPHO_VAULT_ADDRESS=0x944304691E56a7f9Ffb407B966AAe8184Cf9C060

# Aggressive Vault Parameters
VAULT_ADDRESS_AGGRESSIVE=0x72B04f9A0281F9BF84c164C3A27a8Ec70863Fa90
KEEPER_ADDRESS_AGGRESSIVE=0x64f5Ff15b5e7458BB10E064F4728281f14EFDb4e
TARGET_LTV_AGGRESSIVE=0.70
SAFETY_HF_THRESHOLD_AGGRESSIVE=1.10

# Conservative Vault Parameters
VAULT_ADDRESS_CONSERVATIVE=0x4CefA66aF34174eC9aDDD6496D34C893De17952D
KEEPER_ADDRESS_CONSERVATIVE=0xF6846A9B498e56Aa814a0529Bbc3A123d694018a
TARGET_LTV_CONSERVATIVE=0.50
SAFETY_HF_THRESHOLD_CONSERVATIVE=1.10

# Dual-LLM Consensus via Groq API
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY
GROQ_MODEL_A=openai/gpt-oss-20b
GROQ_MODEL_B=openai/gpt-oss-120b

# Agent Execution Settings
POLLING_INTERVAL=30
HEALTH_FACTOR_SAFETY_THRESHOLD=1.15
MOCK_LLM=false
